/** Ejecútala una vez desde el editor: crea las claves con las que este servidor firma los avisos. */
function crearClavesAvisos() {
  var props = PropertiesService.getScriptProperties();
  if (props.getProperty('AVISOS_PUBLICA')) {
    Logger.log('Los avisos ya estaban activados. Las claves no se cambian: si cambiaran, los móviles dejarían de recibirlos.');
    return;
  }
  var privada = Noble.p256.utils.randomPrivateKey();
  props.setProperties({ AVISOS_PRIVADA: b64url_(privada), AVISOS_PUBLICA: b64url_(Noble.p256.getPublicKey(privada, false)) });
  Logger.log('Avisos activados. Ahora: Implementar > Gestionar implementaciones > lápiz > Versión: nueva versión.');
}

/** La clave que necesita el navegador para suscribirse. Vacía mientras no se hayan activado los avisos. */
function clavePublicaAvisos_() {
  return PropertiesService.getScriptProperties().getProperty('AVISOS_PUBLICA') || '';
}

/** Petición para UrlFetchApp.fetchAll que entrega un mensaje ({title, body, tag}) a un dispositivo ({endpoint, p256dh, auth}). */
function peticionAviso_(dispositivo, mensaje) {
  var props = PropertiesService.getScriptProperties();
  var origen = dispositivo.endpoint.match(/^https:\/\/[^\/]+/)[0];
  return {
    url: dispositivo.endpoint,
    method: 'post',
    contentType: 'application/octet-stream',
    payload: aBytes_(cifrarAviso_(deB64url_(dispositivo.p256dh), deB64url_(dispositivo.auth), utf8_(JSON.stringify(mensaje)))),
    headers: {
      Authorization: 'vapid t=' + firmaVapid_(origen, props) + ', k=' + props.getProperty('AVISOS_PUBLICA'),
      'Content-Encoding': 'aes128gcm',
      TTL: '43200', // con el móvil apagado se guarda 12 horas; después ya no sirve de nada
      Urgency: 'high'
    },
    muteHttpExceptions: true
  };
}

/* Cifra el aviso para un navegador (RFC 8291, aes128gcm): solo ese navegador puede leerlo. */
function cifrarAviso_(clavePublicaNavegador, secretoNavegador, texto) {
  var N = Noble, cero = new Uint8Array([0]);
  var privada = N.p256.utils.randomPrivateKey(), publica = N.p256.getPublicKey(privada, false); // de un solo uso
  var compartido = N.p256.getSharedSecret(privada, clavePublicaNavegador).slice(1); // ECDH: la coordenada x
  var ikm = N.hkdf(N.sha256, compartido, secretoNavegador, N.concatBytes(utf8_('WebPush: info'), cero, clavePublicaNavegador, publica), 32);
  var sal = N.randomBytes(16);
  var clave = N.hkdf(N.sha256, ikm, sal, N.concatBytes(utf8_('Content-Encoding: aes128gcm'), cero), 16);
  var nonce = N.hkdf(N.sha256, ikm, sal, N.concatBytes(utf8_('Content-Encoding: nonce'), cero), 12);
  var cifrado = N.gcm(clave, nonce).encrypt(N.concatBytes(texto, new Uint8Array([2]))); // 2: último (y único) bloque
  // Cabecera: sal, tamaño de bloque (4096), longitud de la clave (65) y la clave pública de un solo uso.
  return N.concatBytes(sal, new Uint8Array([0, 0, 16, 0, 65]), publica, cifrado);
}

/* Firma VAPID (RFC 8292): el servicio de avisos comprueba que el aviso viene de este servidor.
   Vale 12 horas; se firma una vez por servicio (Google, Apple, Mozilla...) en cada petición. */
var FIRMAS_VAPID_ = {};
function firmaVapid_(origen, props) {
  if (FIRMAS_VAPID_[origen]) return FIRMAS_VAPID_[origen];
  var datos = b64url_(utf8_(JSON.stringify({ typ: 'JWT', alg: 'ES256' }))) + '.' +
    b64url_(utf8_(JSON.stringify({ aud: origen, exp: Math.floor(Date.now() / 1000) + 12 * 3600, sub: 'mailto:' + props.getProperty('DUENO') })));
  var firma = Noble.p256.sign(Noble.sha256(utf8_(datos)), deB64url_(props.getProperty('AVISOS_PRIVADA'))).toCompactRawBytes();
  return (FIRMAS_VAPID_[origen] = datos + '.' + b64url_(firma));
}

/* Apps Script trabaja con bytes con signo (-128..127); noble, con Uint8Array. */
function deBytes_(bytes) { return Uint8Array.from(bytes, function (b) { return b & 255; }); }
function aBytes_(u8) { return Array.from(u8, function (b) { return b > 127 ? b - 256 : b; }); }
function utf8_(s) { return deBytes_(Utilities.newBlob(s).getBytes()); }
function b64url_(u8) { return sinRelleno_(Utilities.base64EncodeWebSafe(aBytes_(u8))); }
function deB64url_(s) { return deBytes_(Utilities.base64DecodeWebSafe(conRelleno_(s))); }
