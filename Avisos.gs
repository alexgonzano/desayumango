/**
 * AVISOS (notificaciones push) · cifrado y firma del protocolo Web Push
 *
 * Para activarlos, una sola vez:
 *  1. En Apps Script, botón + > Secuencia de comandos, llamada «Avisos». Pega este archivo.
 *  2. Elige la función «crearClavesAvisos» arriba y pulsa Ejecutar.
 *  3. Implementar > Gestionar implementaciones > lápiz > Versión: nueva versión.
 * Después, cada uno los activa desde la app (Ajustes > Avisos).
 *
 * Cada aviso va cifrado para el móvil que lo recibe (RFC 8291) y firmado por este servidor (RFC 8292, VAPID).
 * Apps Script no trae esas operaciones, así que aquí va la librería noble (MIT, ver LICENCIAS-TERCEROS.md).
 * No se edita a mano: se genera así.
 *   npm install --save-exact @noble/curves@1.9.7 @noble/ciphers@1.3.0 esbuild@0.25.12   (trae @noble/hashes@1.8.0)
 *   entrada.js:
 *     export { p256 } from '@noble/curves/p256';
 *     export { gcm } from '@noble/ciphers/aes';
 *     export { hkdf } from '@noble/hashes/hkdf';
 *     export { sha256 } from '@noble/hashes/sha256';
 *     export { concatBytes, randomBytes } from '@noble/hashes/utils';
 *   npx esbuild entrada.js --bundle --format=iife --global-name=Noble --minify --target=es2020 --legal-comments=inline
 *
 * Comprobación (cifra un aviso y lo descifra por separado): node avisos.test.js
 */

// Apps Script no trae crypto.getRandomValues, que noble necesita para las claves de un solo uso.
// Se saca de Utilities.getUuid() (SecureRandom de Java) pasado por SHA-256. Tiene que ir antes de la librería.
if (typeof globalThis.crypto === 'undefined') {
  globalThis.crypto = {
    getRandomValues: function (bytes) {
      for (var i = 0; i < bytes.length; i += 32) {
        var h = Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, Utilities.getUuid() + Utilities.getUuid() + Utilities.getUuid());
        for (var j = 0; j < 32 && i + j < bytes.length; j++) bytes[i + j] = h[j] & 255;
      }
      return bytes;
    }
  };
}

